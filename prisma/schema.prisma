generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Opsional untuk Supabase
}

enum Role {
  OWNER
  EMPLOYEE
}

enum CategoryType {
  INCOME
  EXPENSE
}


// Tambahkan Enum ini di luar model
enum PlanType {
  FREE
  PRO
  PLATINUM
}



model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String
  picture            String?
  role               Role     @default(OWNER)
  ownerId            String?  // Jika role = EMPLOYEE, ini berisi ID Owner-nya
  googleAccessToken  String?
  googleRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  budgets            Budget[]
  plan               PlanType @default(FREE)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  whatsappNumber     String?  @unique // Nomor WA yang terhubung (bisa kosong dulu)
  waLinkingToken     String?  // Menyimpan kode unik sementara (misal: DOWITH-8842)
  waTokenExpiresAt   DateTime? // Batas waktu kadaluarsa kode unik (misal: 10 menit)

  owner           User?             @relation("EmployeeToOwner", fields: [ownerId], references: [id])
  employees       User[]            @relation("EmployeeToOwner")
  categories      Category[]
  transactions    Transaction[]
  smartRules      SmartRule[]
  savingsGoals    SavingsGoal[]
  widgetPrefs     WidgetPreference[]
  magicFormulas   MagicFormula[]
  
}


model Category {
  id        String       @id @default(uuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  color     String?
  createdAt DateTime     @default(now())
  budgets   Budget[]
  

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  smartRules   SmartRule[]
}

model Transaction {
  id            String       @id @default(uuid())
  userId        String
  categoryId    String?      // 👈 Beri tanda tanya agar tidak wajib saat input via WA
  amount        Float        // Skema kamu menggunakan Float, pastikan tipe data aman
  type          CategoryType @default(EXPENSE) // 👈 Beri default 'EXPENSE' (Pengeluaran)
  date          DateTime     @default(now())   // 👈 Beri default tanggal hari ini
  description   String
  paymentMethod String?      
  source        String?      // Bisa diisi "WA_BOT" nanti
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade) // 👈 Beri tanda tanya juga di relasinya
}

model SmartRule {
  id           String   @id @default(uuid())
  userId       String
  keyword      String   // Contoh: "Grab"
  categoryId   String   // Kategori tujuan
  createdAt    DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String    
  targetAmount  Float     
  currentAmount Float     @default(0) 
  deadline      DateTime? 
  color         String?   @default("#10B981") 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Baris ini adalah kunci untuk menghilangkan error P1012
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WidgetPreference {
  id         String  @id @default(uuid())
  userId     String
  widgetName String  // Contoh: "Balance", "Income", "Recent Transaction"
  isVisible  Boolean @default(true)
  orderIndex Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetName])
}

model MagicFormula {
  id        String   @id @default(uuid())
  userId    String
  cellRange String   // Contoh: "Sheet1!Z9"
  label     String   // Contoh: "Prediksi Sisa Modal"
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  amount      Float    
  month       Int      
  year        Int      
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Mencegah 1 kategori punya 2 anggaran di bulan & tahun yang sama
  @@unique([userId, categoryId, month, year])
}

