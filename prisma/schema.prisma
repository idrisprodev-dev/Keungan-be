generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Opsional untuk Supabase
}

enum Role {
  OWNER
  EMPLOYEE
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String
  picture            String?
  role               Role     @default(OWNER)
  ownerId            String?  // Jika role = EMPLOYEE, ini berisi ID Owner-nya
  googleAccessToken  String?
  googleRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sheetId            String?

  // Relasi
  owner           User?             @relation("EmployeeToOwner", fields: [ownerId], references: [id])
  employees       User[]            @relation("EmployeeToOwner")
  sheetConnections SheetConnection[]
  categories      Category[]
  transactions    Transaction[]
  smartRules      SmartRule[]
  savingsGoals    SavingsGoal[]
  widgetPrefs     WidgetPreference[]
  magicFormulas   MagicFormula[]
}

model SheetConnection {
  id            String   @id @default(uuid())
  userId        String
  spreadsheetId String   // ID asli dari Google Drive
  name          String   // Contoh: "Uang Pribadi", "Toko Baju"
  isPrimary     Boolean  @default(false) // Untuk user Pro (hanya 1 sheet utama)
  createdAt     DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  smartRules    SmartRule[]
  magicFormulas MagicFormula[]
}

model Category {
  id        String       @id @default(uuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  color     String?
  createdAt DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  smartRules   SmartRule[]
}

model Transaction {
  id          String       @id @default(uuid())
  userId      String
  sheetId     String       // Merujuk ke sheet mana transaksi ini dicatat
  categoryId  String
  amount      Float
  type        CategoryType
  date        DateTime
  description String
  paymentMethod String?    // Cash, Debit, E-Wallet
  source      String?      // Asal input: "WEB", "WA_BOT"
  createdAt   DateTime     @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet    SheetConnection @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model SmartRule {
  id           String   @id @default(uuid())
  userId       String
  keyword      String   // Contoh: "Grab"
  categoryId   String   // Kategori tujuan
  targetSheetId String? // Opsional: Langsung arahkan ke sheet tertentu
  createdAt    DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sheet    SheetConnection? @relation(fields: [targetSheetId], references: [id], onDelete: Cascade)
}

model SavingsGoal {
  id              String   @id @default(uuid())
  userId          String
  name            String
  targetAmount    Float
  currentAmount   Float    @default(0)
  deadline        DateTime?
  isAutoSweep     Boolean  @default(false)
  sweepPercentage Float?   // Contoh: 10 (berarti 10%)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WidgetPreference {
  id         String  @id @default(uuid())
  userId     String
  widgetName String  // Contoh: "Balance", "Income", "Recent Transaction"
  isVisible  Boolean @default(true)
  orderIndex Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetName])
}

model MagicFormula {
  id        String   @id @default(uuid())
  userId    String
  sheetId   String
  cellRange String   // Contoh: "Sheet1!Z9"
  label     String   // Contoh: "Prediksi Sisa Modal"
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sheet SheetConnection @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}